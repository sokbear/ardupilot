#cloud-config
# Minimal first-boot config (fast boot, no apt on first start).

hostname: epilot-bench
manage_etc_hosts: true
timezone: Europe/Moscow

users:
  - name: pilot
    groups: users,adm,dialout,audio,netdev,video,plugdev,gpio,i2c,render,input,sudo,tty
    shell: /bin/bash
    lock_passwd: false
    plain_text_password: epilot2026
    sudo: ALL=(ALL) NOPASSWD:ALL

enable_ssh: true
ssh_pwauth: true

rpi:
  i2c: true

package_update: false
package_upgrade: false
